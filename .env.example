# Discord Bot Token - Developer Portal -> your app -> Bot -> Reset Token
TOKEN=your_bot_token_here

# Client ID - Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=your_client_id_here

# Optional: a single server ID for fast command deployment during development.
# Commands registered to a guild (this set) update instantly.
# Commands registered globally (this left blank) can take up to an hour to
# show up everywhere. Leave it blank for production so /mimic works in
# every server the bot is invited to.
GUILD_ID=

# Which transcription backend to use: deepgram | assemblyai | selfhosted
TRANSCRIPTION_PROVIDER=

# Required if TRANSCRIPTION_PROVIDER=deepgram - console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# Required if TRANSCRIPTION_PROVIDER=assemblyai - assemblyai.com dashboard -> API Keys
ASSEMBLYAI_API_KEY=

# Required if TRANSCRIPTION_PROVIDER=selfhosted - RunPod dashboard -> Settings -> API Keys
GPU_PROVIDER_API_KEY=
# The RunPod Template ID for the GPU instance (container image + config bundle)
GPU_PROVIDER_TEMPLATE_ID=
# Which GPU to rent, as RunPod's own type identifier(s) (not covered by the
# template) - e.g. "NVIDIA GeForce RTX 4090". See https://docs.runpod.io/api-reference-v2/overview
# or GET /v2/catalog/gpus for valid values. Optionally a comma-separated
# preference list (tried in order) so a capacity shortage on your first
# choice doesn't just fail /mimic start - e.g.
# "NVIDIA GeForce RTX 4090,NVIDIA RTX A5000"
GPU_PROVIDER_GPU_TYPE_ID=
# RunPod cloud tier: COMMUNITY (community-hosted, cheaper - default here) or
# SECURE (RunPod-owned hardware, pricier, stronger guarantees).
GPU_PROVIDER_CLOUD_TYPE=COMMUNITY
# Shared secret required by the self-hosted STT server (must match its
# AUTH_TOKEN) - the server is reachable on the public internet via RunPod's
# public port mapping, not just RunPod's private network, so this is the
# only thing standing between it and anyone who finds the address.
SELFHOSTED_AUTH_TOKEN=

# Base URL for the notes-generation chat-completions endpoint (Anthropic,
# OpenAI, or a self-hosted Ollama/llama.cpp server all work here unchanged)
NOTES_BASE_URL=
NOTES_API_KEY=
NOTES_MODEL=

# Redis connection URL (defaults to redis://127.0.0.1:6379 if unset)
# REDIS_URL=redis://127.0.0.1:6379   # shared instance with the other bots on this Pi, namespaced under mimic:

# Minutes of silence from every speaker before a session auto-ends itself
# (defaults to 15) - the backstop for "everyone went to bed and forgot
# /mimic end", which would otherwise keep a self-hosted GPU billing and a
# Deepgram/AssemblyAI connection open indefinitely.
MIMIC_IDLE_TIMEOUT_MINUTES=15
