    "start": "node index.js",
    "deploy": "node deploy-commands.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "openai": "^7.8.0",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0"
  },
  "license": "ISC",
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
